import { Designer, DefaultWindow } from "shell.slint";
import { ElRow, InsSlot, Tool, Grips } from "types.slint";

// Only what the compiled root exports becomes a Rust type.
export { ElRow, InsSlot, Tool, Grips, DefaultWindow }

// The application window: the designer shell and nothing else. Every property
// and callback is the shell's, forwarded, so the window the operator uses and the
// probe the tests drive run the same F6, Tab and Ctrl+Z code. The five panes of
// DESIGN.md section 6 land in the shell, not inside the canvas.
export component AppWindow inherits Window {
    in property <image> plane <=> shell.plane;
    in property <int> plane-px-w <=> shell.plane-px-w;
    in property <int> plane-px-h <=> shell.plane-px-h;
    in property <int> dots-x <=> shell.dots-x;
    in property <int> dots-y <=> shell.dots-y;
    in property <[ElRow]> rows <=> shell.rows;
    in property <int> selected <=> shell.selected;
    in property <int> zoom <=> shell.zoom;
    in property <Grips> grips <=> shell.grips;
    in property <[Tool]> tools <=> shell.tools;
    in property <[InsSlot]> ins-slots <=> shell.ins-slots;
    in property <string> ins-heading <=> shell.ins-heading;
    in property <bool> ins-shown <=> shell.ins-shown;
    in property <string> ins-captions <=> shell.ins-captions;
    in property <int> pan-x <=> shell.pan-x;
    in property <int> pan-y <=> shell.pan-y;
    in property <int> scene-x <=> shell.scene-x;
    in property <int> scene-y <=> shell.scene-y;
    in property <int> scene-w <=> shell.scene-w;
    in property <int> scene-h <=> shell.scene-h;
    in property <string> zoom-says <=> shell.zoom-says;
    out property <int> view-px-w <=> shell.view-px-w;
    out property <int> view-px-h <=> shell.view-px-h;
    out property <int> grip-reach-px <=> shell.grip-reach-px;
    out property <bool> pointer-down <=> shell.pointer-down;
    in property <string> status <=> shell.status;

    callback select(id: int);
    callback begin-move(id: int);
    callback move-to(id: int, x: int, y: int);
    callback end-move(committed: bool);
    callback nudge(id: int, dx: int, dy: int, coarse: bool);
    callback set-say(id: int, value: string);
    callback undo();
    callback redo();
    callback begin-resize(id: int, grip: int);
    callback resize-to(id: int, right: int, bottom: int);
    callback add(kind: int) -> bool;
    callback kind-of-key(text: string) -> int;
    callback delete-element(id: int) -> bool;
    callback field-edited(field: int, value: string);
    callback field-commit();
    callback field-stepped(field: int, by: int);
    callback zoom-step(by: int);
    callback zoom-one();
    callback zoom-fit();
    callback zoom-wheel(travel: float, at-x: float, at-y: float);
    callback pan-by(dx: float, dy: float);
    callback pan-to(x: int, y: int);
    callback view-resized();

    public function show-fields() {
        shell.show-fields();
    }

    public function focus-canvas() {
        shell.focus-canvas();
    }

    title: "relabel";
    // From the shell's global, which the test probe is sized from too.
    preferred-width: DefaultWindow.width;
    preferred-height: DefaultWindow.height;

    shell := Designer {
        // A component with no base of its own is placed at its preferred size
        // and centred, which would leave the canvas column no width at all.
        width: 100%;
        height: 100%;
        select(id) => { root.select(id); }
        begin-move(id) => { root.begin-move(id); }
        move-to(id, x, y) => { root.move-to(id, x, y); }
        end-move(c) => { root.end-move(c); }
        nudge(id, dx, dy, c) => { root.nudge(id, dx, dy, c); }
        set-say(id, v) => { root.set-say(id, v); }
        undo() => { root.undo(); }
        redo() => { root.redo(); }
        begin-resize(id, g) => { root.begin-resize(id, g); }
        resize-to(id, r, b) => { root.resize-to(id, r, b); }
        add(k) => { return root.add(k); }
        kind-of-key(t) => { return root.kind-of-key(t); }
        delete-element(id) => { return root.delete-element(id); }
        field-edited(f, v) => { root.field-edited(f, v); }
        field-commit() => { root.field-commit(); }
        field-stepped(f, b) => { root.field-stepped(f, b); }
        zoom-step(by) => { root.zoom-step(by); }
        zoom-one() => { root.zoom-one(); }
        zoom-fit() => { root.zoom-fit(); }
        zoom-wheel(t, x, y) => { root.zoom-wheel(t, x, y); }
        pan-by(dx, dy) => { root.pan-by(dx, dy); }
        pan-to(x, y) => { root.pan-to(x, y); }
        view-resized() => { root.view-resized(); }
    }
}
