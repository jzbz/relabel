import { ZoomButton } from "zoom.slint";
import { Tool } from "types.slint";

// The edit bar: one button for each kind an operator can add, and one that deletes
// the selection.
//
// The add buttons come from a model pushed once from `make::Kind`, so a face, the
// name it announces and the chord it describes are spelled once, in Rust, beside
// the letters the shell's capture sends back. ZoomButtons for the zoom bar's
// reason: none is a Tab stop and none takes the keyboard, so Tab still goes from
// the surface to the first element. The default action is the assistive
// technology's route to each, and the only one to Delete element, because Slint
// has no delete action (i-slint-compiler typeregister.rs:257-283).
export component EditBar {
    in property <[Tool]> tools;
    callback add(token: int);
    callback delete-selected();
    HorizontalLayout {
        spacing: 4px;
        for tool in root.tools: ZoomButton {
            text: tool.text;
            name: tool.name;
            keys: tool.keys;
            clicked => { root.add(tool.token); }
        }
        ZoomButton {
            text: "Delete";
            name: "Delete element";
            keys: "Delete";
            clicked => { root.delete-selected(); }
        }
    }
}

// The File bar: New, Open, Save and Save as, from a model pushed once from
// `filing::Want`, for the edit bar's reason. ZoomButtons for its reason too: the
// four chords reach them from anywhere, so none costs a Tab stop on the way to the
// canvas, and the default action is the assistive technology's route.
export component FileBar {
    in property <[Tool]> tools;
    callback command(token: int);
    // A button's height whether or not the model has arrived: a window whose files
    // are not wired - most test probes - has an empty bar, which would otherwise
    // take a share of the column's height from the view.
    min-height: 28px;
    max-height: 28px;
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        for tool in root.tools: ZoomButton {
            text: tool.text;
            name: tool.name;
            keys: tool.keys;
            clicked => { root.command(tool.token); }
        }
    }
}
