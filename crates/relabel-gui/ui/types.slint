// Structs shared with Rust. Everything here is pre-computed by relabel-gui's
// own `rows` module: the canvas never parses, formats or converts a value, and
// never decides which axis the print head runs along.

// One element, as the canvas draws it.
//
// `x` and `y` are *canvas* dots - the picture as the operator sees it, after
// `Target::place` has swapped the axes for the printer this label was drawn
// for - and `w` and `h` are the element's extent as drawn, after its rotation
// has swapped them. The document's own feed/head names deliberately do not
// appear: keeping them here would invite the canvas to multiply the wrong one
// by the zoom, and a transposed rectangle is still a rectangle, so nothing
// about the picture would look wrong.
export struct ElRow {
    id: int,
    x: int,
    y: int,
    w: int,
    h: int,
    // What an assistive technology reads, built in Rust so that this sentence
    // and the parser that reads it back cannot drift apart.
    say: string,
    // Refuses a drag and a nudge, still selectable and still readable. The
    // flag is in the file format and this is the only thing in the workspace
    // that honours it.
    locked: bool,
    // 0 clear, then the Keepout ordinals: 1 repeated, 2 tail, 3 inset,
    // 4 outside the die-cut. The tone comes from media::Bounds, which is what
    // preflight reads, so a red frame and a refused run cannot disagree.
    keepout: int,
    // Whole dots of canvas beside the frame - left, right, up, down - that the
    // pointer padding round a small frame may cover without reaching the frame of
    // an element drawn earlier. `geom::clearances` says why only earlier ones.
    clear-left: int,
    clear-right: int,
    clear-up: int,
    clear-down: int,
}

// One field of the inspector, whichever field it happens to be this selection.
//
// Every string here was formatted in Rust, every number decided there. The pane
// parses nothing, formats nothing, converts no unit, enforces no range, and does
// not know that element kinds exist: `Element::own_keys` answers which fields a
// kind has, and that answer must not exist twice.
export struct InsSlot {
    // 0 unused, 1 a number, 2 a string, 3 read-only. Not an exported Slint enum,
    // for `ElRow.keepout`'s reason: a shape this build does not know must draw as
    // nothing rather than fall out of a match.
    shape: int,
    // An opaque token minted by relabel-gui's `ins` module and handed straight
    // back in the callbacks. Nothing in this file reads it or compares it, which
    // is why an integer is safe here where a spelled key would invite a typo no
    // compiler would catch.
    field: int,
    // Drawn beside the field, and announced as its name. A field nobody can see
    // the name of is not a keyboard path.
    label: string,
    // The value, as Rust formatted it. Assigned into the widget by `show`, never
    // bound to it: see the note at the top of `inspector.slint`.
    value: string,
    // The unit, drawn after the field and announced as its description: "dots",
    // "degrees", or the spellings an open value set takes.
    unit: string,
    // What an empty field means. Shown as placeholder text, so it is only ever
    // read when the field is in fact empty.
    hint: string,
    // Announced to an assistive technology, never enforced by a widget: a widget
    // that enforced a range would be the second place the rules live, and the
    // silent one.
    minimum: float,
    maximum: float,
    // What one increment is, in this field's own unit. Settable here, unlike a
    // std SpinBox's, which announces (maximum - minimum) / 100.
    step: float,
    read-only: bool,
}

// One button of the edit bar, pushed once from `make::Kind`: the face, the name an
// assistive technology announces, and the chord it announces as its description.
// `token` is handed straight back in `add`, for `InsSlot.field`'s reason.
export struct Tool {
    token: int,
    text: string,
    name: string,
    keys: string,
}

// The selected element's grips, pushed after every outcome.
//
// `x`, `y`, `w` and `h` are the element's box in canvas dots, as `ElRow` has it, and
// `id` is -1 when nothing drawn is selected. The rooms are whole dots on a side of
// the squares beyond the east edge, the south edge and their corner that no other
// element's ink is in (`geom::grip_room`); a grip is offered only where its room is
// at least twenty logical pixels, so it never covers another element's ink or its
// padding.
export struct Grips {
    id: int,
    x: int,
    y: int,
    w: int,
    h: int,
    locked: bool,
    room-e: int,
    room-s: int,
    room-se: int,
}

// One preset of the New label pane, pushed from `fresh::offers` each time the pane
// opens: the face, the name an assistive technology announces, and the size in dots
// it announces as its description. `token` is the length along the feed in tenths
// of a millimetre, handed straight back in `preset`.
export struct SizePreset {
    token: int,
    text: string,
    name: string,
    says: string,
}

// One row of the Preview pane's issue list, severity first, as `proof` says it.
export struct IssueRow {
    text: string,
}

// One printer the Preview pane offers while choosing, from `printing`: the face,
// and what the button announces as its description.
export struct ChoiceRow {
    text: string,
    says: string,
}
