import { ElRow, Grips } from "types.slint";

// The label as dots, with a frame round every element the operator can move.
//
// Hand-rolled because Slint 1.17 has no Canvas element and its DragArea moves
// a data payload rather than geometry. Everything here is a Rectangle, an
// Image, a TouchArea and a FocusScope.
//
// # Nothing in here owns anything
//
// Every gesture is a callback into Rust, which mutates the document and writes
// the row back. No binding in this file assigns to a model row, which is worth
// stating because a field assignment on a repeater row is rewritten by the
// compiler into read-whole-struct / rebuild / assign-whole-row; keeping the
// rules in Rust means that rewrite never happens and the same rule can be
// reached by a unit test as well as by a gesture.
//
// # Dots, physical pixels, and why there is no `px` anywhere below
//
// `zoom` is a whole number of *device* pixels per printer dot - the same
// integer `preview::Scale::up` was given - so the dot grid lands on whole
// device pixels at any display scale, including the 1.25x and 1.5x that
// Windows and GNOME default to. `dot` is that integer as a length, and every
// position in this file is an integer number of dots times `dot`. A size
// stated in logical `px` would be multiplied by a fractional scale factor and
// give one dot two device pixels and its neighbour three.
export component LabelCanvas {
    // --- what to draw ---
    // The 1-bit plane, already expanded to `zoom` device pixels per dot by
    // relabel-render. The toolkit never scales it: source and target are the
    // same size in device pixels, so no filter runs.
    in property <image> plane;
    in property <int> plane-px-w;
    in property <int> plane-px-h;
    // The canvas's own extent in canvas dots. From the document rather than
    // from the image: a label whose render failed still has to show its
    // element frames, and a pane sized from an image that is not there would
    // be a pane of nothing.
    in property <int> dots-x;
    in property <int> dots-y;
    // One row per drawable element, in document z-order. Later rows paint over
    // earlier ones, which is also the order Slint hit-tests them in, so the
    // topmost element takes a click with no reverse iteration anywhere.
    in property <[ElRow]> rows;
    // The selected element's id, or -1. An `in` property, not `in-out`: the
    // document owns the selection, because the rule that a locked element is
    // selectable but not movable has to live next to the element.
    in property <int> selected: -1;
    in property <int> zoom: 4;
    // The selected element's drawn box and the room beyond its far edges, for the
    // grips. Rust pushes it after every outcome; a probe that never pushes it keeps
    // the id -1 and offers no grip.
    in property <Grips> grips: { id: -1 };

    // --- where it is seen from ---
    // False in the canvas probe, which has no view round it: every frame is then its
    // own node and its Tab point is the 12c one, exactly, and the probe's tests pin
    // that.
    in property <bool> viewed: false;
    // The part of this canvas a view above shows, in this component's own lengths.
    in property <length> seen-x;
    in property <length> seen-y;
    in property <length> seen-width;
    in property <length> seen-height;
    // True from a press on an element to its release or cancel. Written before the
    // press moves the keyboard, so the selection that press makes can be told from
    // Tab's: a view that moved inside a press would leave the grab offset measured
    // against a canvas that is no longer there.
    out property <bool> pointer-down: false;

    // --- what the operator does ---
    // Selection follows focus, so this fires for a click and for a Tab alike.
    callback select(id: int);
    // Pointer down on an element: open one undo step for the whole gesture.
    callback begin-move(id: int);
    // Canvas dots, absolute, not a delta. Sent on every move event.
    callback move-to(id: int, x: int, y: int);
    // Pointer up, or a cancelled gesture, which is the one that must roll back.
    callback end-move(committed: bool);
    // dx and dy are -1, 0 or 1. How far one step is - one dot, or a
    // millimetre's worth of dots at this label's pitch - is Rust's to decide.
    callback nudge(id: int, dx: int, dy: int, coarse: bool);
    // An assistive technology wrote a new placement. Rust parses it; an
    // unparseable one moves nothing.
    callback set-say(id: int, value: string);
    callback undo();
    callback redo();
    // Pointer down on a grip: open one undo step for the resize that follows. `grip`
    // is 0 east, 1 south, 2 their corner (`geom::Grip::token`).
    callback begin-resize(id: int, grip: int);
    // Canvas dots, absolute: the exclusive far edges the grip has been dragged to.
    // Sent on every move event, and ended by `end-move` like a move.
    callback resize-to(id: int, right: int, bottom: int);
    // The keyboard arrived on the canvas surface rather than on an element: a
    // click on bare canvas, or `focus-canvas` below. A callback of its own because
    // it selects nothing, and a pane beside the canvas has no other way to learn
    // that the keyboard left it with an edit still to finish. Not raised when a
    // window or a popup hands the keyboard back, which is a return, not an arrival.
    callback surface-focused();

    // One printer dot as a length.
    out property <length> dot: root.zoom * 1phx;
    // Where the grips sit: `grip-gap` beyond their edge, `grip-size` square.
    out property <length> grip-gap: 6px;
    out property <length> grip-size: 8px;
    // How far past the selected frame's far edges the view's pan reaches for the
    // grips, in whole device pixels: the grips' far edge rounded up, and one more for
    // the half pixel the dot grid's anchor can add (`grid` below). With the pan at the
    // end of that reach a grip on the label's end lies inside the view's clip.
    // `Math.ceil` answers an int (i-slint-compiler expression_tree.rs:199).
    out property <int> grip-reach-px: Math.ceil((root.grip-gap + root.grip-size) / 1phx) + 1;
    // This component's own origin in *device* pixels, which at a fractional
    // display scale is a fractional number. Dividing a length by `1phx`
    // converts it, so nothing has to be told the scale factor from Rust and
    // there is no stale copy of it to go wrong when a window moves between
    // monitors.
    property <float> origin-px-x: root.absolute-position.x / 1phx;
    property <float> origin-px-y: root.absolute-position.y / 1phx;

    width: root.dots-x * root.dot;
    height: root.dots-y * root.dot;

    // The dot a point is on, in canvas dots, from its distance from the dot grid's
    // origin. Here rather than in the element's TouchArea so a grip reads the pointer
    // with the same arithmetic as a move.
    //
    // Floored, so the element steps as the pointer enters the next dot. Rounded, it
    // stepped at the middle of a dot, and the dot the operator took ran up to half a
    // dot ahead of or behind the pointer: eight device pixels at 16x.
    //
    // A sixteenth of a device pixel is added before the floor. A pointer on a dot's
    // first device pixel arrives here through two chains of float additions and at a
    // fractional display scale can land a hair short of it, which a bare floor reads
    // as the dot before: a press at an element's centre and a ten-dot drag landed one
    // dot short at 1.5x, and one dot long at 1.25x (measured).
    function dot-of(from-grid: length) -> int {
        Math.floor((from-grid / 1phx + 0.0625) / root.zoom)
    }

    // The canvas-wide key handler. It surrounds the per-element FocusScopes,
    // so a key an element rejected arrives here.
    keys := FocusScope {
        focus-gained(reason) => {
            if (reason != FocusReason.window-activation
                && reason != FocusReason.popup-activation) {
                root.surface-focused();
            }
        }
        key-pressed(event) => {
            // Both cases: a keyboard sends Ctrl+Shift+Z with the shifted character,
            // which is why Slint's own shortcut table matches "z" | "Z" for Redo
            // (i-slint-core input.rs:991-996).
            if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                if (event.modifiers.shift) { root.redo(); } else { root.undo(); }
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        // The dot grid's origin.
        //
        // Its offset cancels whatever fraction of a device pixel the layout
        // above left in this component's own absolute position, so the dots
        // sit on whole device pixels however the pane was placed. Without it a
        // canvas centred in an odd-width pane at 1.25x lands on a half pixel,
        // and i-slint-renderer-femtovg translates by an unrounded physical
        // distance (itemrenderer.rs:897) - the software renderer rounds, so
        // the two would not even disagree the same way.
        grid := Rectangle {
            x: (Math.round(root.origin-px-x) - root.origin-px-x) * 1phx;
            y: (Math.round(root.origin-px-y) - root.origin-px-y) * 1phx;
            width: root.width;
            height: root.height;

            // There is no canvas or graphic role in AccessibleRole, so the
            // surface is a list and each element a list-item. It is the closest
            // honest mapping: a list has a count, its items have indices, and
            // an item can be selected.
            accessible-role: list;
            accessible-label: "Label canvas";
            accessible-item-count: root.rows.length;

            // The view, in grid coordinates.
            property <length> view-left: root.seen-x - self.x;
            property <length> view-top: root.seen-y - self.y;
            property <length> view-right: self.view-left + root.seen-width;
            property <length> view-bottom: self.view-top + root.seen-height;
            // The view shrunk by one device pixel on every side, for where a point is
            // put and never for whether a frame is seen. `is_visible` tests a
            // zero-sized item against its clip inclusively (i-slint-core
            // item_tree.rs:397-408), and a point on the very edge, reached through two
            // chains of float additions, can land a hair outside.
            property <length> sight-left: self.view-left + 1phx;
            property <length> sight-top: self.view-top + 1phx;
            property <length> sight-right: self.view-right - 1phx;
            property <length> sight-bottom: self.view-bottom - 1phx;

            Image {
                x: 0phx;
                y: 0phx;
                width: root.plane-px-w * 1phx;
                height: root.plane-px-h * 1phx;
                source: root.plane;
                // Not an accessibility node: the dots are described by the
                // elements that drew them, and an unlabelled graphic inside the
                // list would be one more thing to skip past.
                accessible-role: none;
                // fill, not preserve: preserve keeps a size in *logical*
                // pixels and then multiplies by the scale factor. The size is
                // already stated in device pixels above, so fill is a 1:1 blit.
                image-fit: fill;
                // A belt for the case where a clamped zoom or a rounding
                // somewhere leaves source and target a pixel apart: nearest
                // neighbour keeps the dots square instead of smearing them.
                image-rendering: pixelated;
            }

            for row[i] in root.rows: frame := Rectangle {
                property <length> fx: row.x * root.dot;
                property <length> fy: row.y * root.dot;
                property <length> fw: row.w * root.dot;
                property <length> fh: row.h * root.dot;
                // Whether any of the frame is in view. When none is, this node shrinks
                // to a point just inside the nearest edge rather than leaving: Tab
                // skips an item a plain clip hides (window.rs:1325-1328), the
                // accessibility tree marks it hidden (accesskit.rs:576-577), and with
                // the pan in the operator's hands that can be any element at all. The
                // node keeps its role, index, sentence and set-value action, so a
                // screen reader still lists it and can still move it.
                //
                // Against the view itself, not the inset one: a frame reaching a single
                // device pixel into the view keeps that pixel and its press. Against the
                // inset, the one dot slice 12 leaves on the label after a drag off its
                // start was that pixel at 1x, collapsed, and took no press.
                property <bool> in-sight: !root.viewed
                    || (self.fx < grid.view-right && self.fx + self.fw > grid.view-left
                        && self.fy < grid.view-bottom && self.fy + self.fh > grid.view-top);
                x: self.in-sight ? self.fx : Math.max(grid.sight-left, Math.min(self.fx, grid.sight-right));
                y: self.in-sight ? self.fy : Math.max(grid.sight-top, Math.min(self.fy, grid.sight-bottom));
                width: self.in-sight ? self.fw : 0phx;
                height: self.in-sight ? self.fh : 0phx;

                // Chrome over the dots, never the dots themselves: the element's
                // content is already in the image below, so the frame is an
                // outline and a wash. A hairline is 1 device pixel at any
                // display scale - 1px would be two pixels at 2x and one and a
                // quarter at 1.25x.
                background: root.selected == row.id
                    ? (row.keepout == 0 ? #1a6dd41f : #d418181f)
                    : #00000000;
                border-width: root.selected == row.id ? 2phx : 1phx;
                border-color: row.keepout != 0
                    ? #d41818
                    : (root.selected == row.id
                        ? #1a6dd4
                        : (row.locked ? #8a8a8a : #33333388));

                accessible-role: list-item;
                accessible-item-index: i;
                accessible-item-selectable: true;
                accessible-item-selected: root.selected == row.id;
                // The label is the sentence; the value is the same sentence,
                // because the value is the half an assistive technology may
                // write back and it has to be readable before it is writable.
                accessible-label: row.say;
                accessible-value: row.say;
                accessible-action-set-value(v) => {
                    root.set-say(row.id, v);
                }

                forward-focus: focus;

                // Zero-sized on purpose, the pattern SliderBase uses: focus
                // without taking the pointer events the TouchArea beside it
                // needs. Selection follows focus, so Tab selects what it lands
                // on and a click selects through focus() below - one rule, not
                // two.
                //
                // On the part of the frame that is on the canvas, not at the frame's
                // origin. Tab skips a focus item whose own geometry is outside a
                // clipping ancestor (i-slint-core item_tree.rs:399-410,
                // window.rs:1327), and a point at the origin is outside the canvas
                // as soon as the placement is negative - which `keep_reachable`
                // allows until one dot is left, so an element with 39 of its 40
                // dots in view had dropped out of the Tab order, and Tab is the only
                // keyboard route back to it. `grid`'s offset is taken off too, since
                // it can put a point at the canvas's own edge a fraction outside.
                focus := FocusScope {
                    // Viewed, the first point of the frame that is in view, so the
                    // element holding the keyboard never has a focus item outside the
                    // view: a key press drops the keyboard altogether while it has
                    // (window.rs:1076-1082). A collapsed node is already that point.
                    // Unviewed, the formula above, which keeps a negative placement's
                    // Tab stop on the canvas.
                    x: !root.viewed ? Math.max(0phx, -row.x * root.dot - grid.x)
                        : (frame.in-sight ? Math.max(0phx, grid.sight-left - frame.fx) : 0phx);
                    y: !root.viewed ? Math.max(0phx, -row.y * root.dot - grid.y)
                        : (frame.in-sight ? Math.max(0phx, grid.sight-top - frame.fy) : 0phx);
                    width: 0phx;
                    height: 0phx;
                    focus-gained(reason) => {
                        root.select(row.id);
                    }
                    key-pressed(event) => {
                        if (event.text == Key.LeftArrow) {
                            root.nudge(row.id, -1, 0, event.modifiers.shift);
                            return EventResult.accept;
                        }
                        if (event.text == Key.RightArrow) {
                            root.nudge(row.id, 1, 0, event.modifiers.shift);
                            return EventResult.accept;
                        }
                        if (event.text == Key.UpArrow) {
                            root.nudge(row.id, 0, -1, event.modifiers.shift);
                            return EventResult.accept;
                        }
                        if (event.text == Key.DownArrow) {
                            root.nudge(row.id, 0, 1, event.modifiers.shift);
                            return EventResult.accept;
                        }
                        // Everything else - Ctrl+Z included - goes to the
                        // canvas scope that surrounds this one.
                        return EventResult.reject;
                    }
                }

                grab := TouchArea {
                    // Inflated to a size a pointer can actually hit: a 1-dot
                    // rule is one device pixel tall at 1x and nobody can
                    // click it. The arithmetic below does not care, because it
                    // reads the pointer's own position rather than this area's
                    // geometry, so the hit area is free to differ from the
                    // frame.
                    //
                    // Padded only as far as `row.clear-*` allow, which stop short of
                    // every frame drawn earlier. This row is asked about a press before
                    // every earlier row (i-slint-core input.rs:1602-1613, :1659-1663),
                    // so padding centred on the frame took presses on an earlier
                    // element's own drawn frame: at 1x a rule one dot under a box took
                    // the box's last row. Over a later frame it is harmless, since that
                    // row is asked first.
                    //
                    // No hit area at all for a node that is only a point: it draws
                    // nothing there, so it must take no press there. A node that
                    // collapses in the middle of a drag keeps the grab (input.rs
                    // handle_mouse_grab), and the pointer is read from absolute
                    // positions below, so that drag still lands exactly.
                    property <length> min-grab: frame.in-sight ? 10px : 0px;
                    property <length> reach-x: Math.max(0px, (self.min-grab - parent.width) / 2);
                    property <length> reach-y: Math.max(0px, (self.min-grab - parent.height) / 2);
                    property <length> pad-left: Math.min(self.reach-x, row.clear-left * root.dot);
                    property <length> pad-right: Math.min(self.reach-x, row.clear-right * root.dot);
                    property <length> pad-up: Math.min(self.reach-y, row.clear-up * root.dot);
                    property <length> pad-down: Math.min(self.reach-y, row.clear-down * root.dot);
                    // While this row holds the pointer, the whole of what is seen, for
                    // the grips' reason below: a feed, head or length still being typed
                    // is written at the press, which can take the frame away from the
                    // pointer, and the toolkit then cancels the grab of the item the
                    // pointer is no longer inside, so the move ended before it began
                    // (measured).
                    x: grid.grab-held == row.id ? grid.held-x - parent.x : -self.pad-left;
                    y: grid.grab-held == row.id ? grid.held-y - parent.y : -self.pad-up;
                    width: grid.grab-held == row.id ? grid.held-w
                        : parent.width + self.pad-left + self.pad-right;
                    height: grid.grab-held == row.id ? grid.held-h
                        : parent.height + self.pad-up + self.pad-down;
                    mouse-cursor: row.locked ? MouseCursor.not-allowed : MouseCursor.move;

                    // Dots between the pointer and the element's origin, taken
                    // at the press and held for the gesture.
                    property <int> grab-x;
                    property <int> grab-y;

                    // The dot the pointer is on, in canvas dots, through `root.dot-of`.
                    //
                    // `absolute-position + mouse-x` rather than the documented
                    // `mouse-x - pressed-x` idiom, and this is the one thing in
                    // the file that must not be simplified. That idiom is valid
                    // only while the TouchArea does not move; this one travels
                    // with the element it is dragging, so each interpolated
                    // move event reports a mouse-x measured from an origin that
                    // has already followed the pointer, and the measured delta
                    // decays to nothing. `absolute-position` lowers to
                    // ItemAbsolutePosition(self) + {x: self.x, y: self.y} and
                    // depends reactively on every ancestor's x and y, so this
                    // sum is the pointer's position in the window whatever the
                    // element underneath it did.
                    function ptr-x() -> int {
                        root.dot-of(self.absolute-position.x + self.mouse-x
                                    - grid.absolute-position.x)
                    }
                    function ptr-y() -> int {
                        root.dot-of(self.absolute-position.y + self.mouse-y
                                    - grid.absolute-position.y)
                    }

                    // Only the primary button opens a gesture, and any button's release
                    // ends one. A TouchArea gives up its grab at the release of any
                    // button (i-slint-core items/input_items.rs:154-177, and
                    // input.rs:1397-1405 then drops it), so after a second button comes
                    // up the rest of the drag reaches nothing here; the release is the
                    // end of the hold, and ending the gesture there keeps what was
                    // dragged as its own step and leaves nothing held that the toolkit
                    // has let go. A second button's press opening a gesture of its own
                    // dropped the first drag's step (measured).
                    //
                    // The pointer is taken by the caller, before anything here moves
                    // the frame: `mouse-x` was measured from where this area stood when
                    // the event arrived, so read against an area that has since moved,
                    // it is somewhere else. The offsets are taken after the move is
                    // opened, against the placement a typed value has landed on, as a
                    // grip's are: a five-dot drag after typing a feed of 100 moves the
                    // element to 105. This function assigns properties, so `row` is
                    // not read into a local ahead of the callbacks, for `grip-event`'s
                    // reason.
                    function grab-event(kind: PointerEventKind, button: PointerEventButton,
                                        at-x: length, at-y: length) {
                        if (kind == PointerEventKind.down && button == PointerEventButton.left) {
                            // Before the keyboard moves: the selection `focus()`
                            // makes has to be seen as a press's and not as Tab's.
                            root.pointer-down = true;
                            grid.grab-held = row.id;
                            focus.focus();
                            root.begin-move(row.id);
                            // A difference of two floored values, so the
                            // element does not jump to the grid under the
                            // pointer at the press and does not drift over a
                            // long drag: at zero movement the placement below
                            // is exactly where the element already was.
                            self.grab-x = root.dot-of(at-x - grid.absolute-position.x) - row.x;
                            self.grab-y = root.dot-of(at-y - grid.absolute-position.y) - row.y;
                        }
                        // Cleared before the release is reported, so the outcome of
                        // the release is the first one a view may act on.
                        if (kind == PointerEventKind.up) {
                            grid.grab-held = -1;
                            root.pointer-down = false;
                            root.end-move(true);
                        }
                        if (kind == PointerEventKind.cancel) {
                            grid.grab-held = -1;
                            root.pointer-down = false;
                            root.end-move(false);
                        }
                    }
                    pointer-event(event) => {
                        self.grab-event(event.kind, event.button,
                                        self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                    }

                    moved => {
                        if (self.pressed) {
                            root.move-to(row.id,
                                         self.ptr-x() - self.grab-x,
                                         self.ptr-y() - self.grab-y);
                        }
                    }
                }
            }

            // The selected element's grips: its east edge, its south edge and their
            // corner. Only the far edges, because the origin is the placement the
            // operator set (`geom::Grip`).
            //
            // Declared after the rows, so they are hit-tested before every row
            // (i-slint-core item_tree.rs:1379) and drawn over them. Each sits
            // `grip-gap` beyond its edge, `grip-size` square at every zoom, and is
            // offered only where `geom::grip_room` finds a square twenty pixels on a
            // side, centred on the middle of its edge or beyond the corner, with no
            // other element's ink in it. Six is more than the five the widest grab
            // padding reaches (`min-grab` above), and twenty leaves six clear of the
            // grip on every side, so a grip covers no element's ink and no element's
            // padding. A stroked rectangle is ink only under its stroke, so a grip may
            // lie on the paper inside one, over its frame, and a press on that grip
            // resizes the selected element instead of moving the rectangle. A grip not
            // offered is zero-sized rather than removed, and a zero-sized TouchArea
            // takes no press (input.rs:1602-1613); a drag that shrinks it keeps its
            // grab (input.rs:1308-1380).
            //
            // The view's pan reaches `grip-reach-px` past the selected frame's far
            // edges (`view::scene`), so a grip on the label's end is never left outside
            // the port's clip, where it could be neither seen nor pressed.
            //
            // While a grip holds the pointer its hit area is the whole of what is seen,
            // and only the square drawn inside it stays at the edge. The press can move
            // the edge: Rust writes a length still being typed before it opens the
            // resize. Once the press has been handled the toolkit sends an exit to every
            // item the pointer is no longer inside (input.rs:1522, :1424-1441), and a
            // TouchArea answers an exit it holds the grab for with a cancel
            // (items/input_items.rs:140-152), so a grip that moved away from the pointer
            // inside its own press ended the resize before it began (measured).
            //
            // No accessibility node: the feed length and head length fields are the
            // keyboard's and an assistive technology's way to resize.
            property <length> box-x: root.grips.x * root.dot;
            property <length> box-y: root.grips.y * root.dot;
            property <length> box-w: root.grips.w * root.dot;
            property <length> box-h: root.grips.h * root.dot;
            // The frame's own `in-sight`, restated for the pushed box: a property of a
            // repeated row cannot be read from outside the repeater.
            property <bool> box-in-sight: !root.viewed
                || (grid.box-x < grid.view-right && grid.box-x + grid.box-w > grid.view-left
                    && grid.box-y < grid.view-bottom && grid.box-y + grid.box-h > grid.view-top);
            property <bool> grips-on: root.grips.id >= 0 && root.grips.id == root.selected
                && !root.grips.locked && grid.box-in-sight;
            // The element and the dots between the pointer and the gripped edges, taken
            // at the press and held for the gesture, as `grab-x` and `grab-y` are.
            property <int> grip-id: -1;
            property <int> grip-dx;
            property <int> grip-dy;
            // Which grip holds the pointer, by its token, or -1.
            property <int> grip-held: -1;
            // Which element's frame holds the pointer, by its id, or -1.
            property <int> grab-held: -1;
            // What a held grip's or frame's hit area covers: the view, or the whole
            // canvas in a probe with no view round it.
            property <length> held-x: root.viewed ? grid.view-left : 0px;
            property <length> held-y: root.viewed ? grid.view-top : 0px;
            property <length> held-w: root.viewed ? root.seen-width : root.width;
            property <length> held-h: root.viewed ? root.seen-height : root.height;

            // A grip's pointer event, with the pointer's position in the window, taken
            // by the caller before anything here moves the grip. The move's arithmetic,
            // not the design-mode resizer's: `absolute-position + mouse-x` for `grab`'s
            // reason, since a grip travels with the edge it drags. Only the primary
            // button opens a resize, and any button's release ends one, for `grab`'s
            // reason.
            //
            // The resize is opened before the offsets are measured, because opening it
            // writes a length still being typed and that moves the edge. Measured after,
            // a ten-dot drag is ten dots longer than the length typed. This function
            // assigns properties, so the compiler does not read `grips` into a local
            // ahead of the callback (deduplicate_property_read.rs:102-106, :143-145, :164-166),
            // which is the hazard `remove-selected` in shell.slint works round.
            function grip-event(grip: int, kind: PointerEventKind, button: PointerEventButton,
                                at-x: length, at-y: length) {
                if (kind == PointerEventKind.down && button == PointerEventButton.left) {
                    root.pointer-down = true;
                    grid.grip-held = grip;
                    grid.grip-id = root.grips.id;
                    root.begin-resize(grid.grip-id, grip);
                    grid.grip-dx = root.dot-of(at-x - grid.absolute-position.x) - (root.grips.x + root.grips.w);
                    grid.grip-dy = root.dot-of(at-y - grid.absolute-position.y) - (root.grips.y + root.grips.h);
                }
                if (kind == PointerEventKind.up) {
                    grid.grip-held = -1;
                    root.pointer-down = false;
                    root.end-move(true);
                }
                if (kind == PointerEventKind.cancel) {
                    grid.grip-held = -1;
                    root.pointer-down = false;
                    root.end-move(false);
                }
            }
            function grip-moved(at-x: length, at-y: length) {
                root.resize-to(grid.grip-id,
                               root.dot-of(at-x - grid.absolute-position.x) - grid.grip-dx,
                               root.dot-of(at-y - grid.absolute-position.y) - grid.grip-dy);
            }

            grip-e := TouchArea {
                property <length> at-x: grid.box-x + grid.box-w + root.grip-gap;
                property <length> at-y: grid.box-y + grid.box-h / 2 - root.grip-size / 2;
                property <length> size: grid.grips-on && root.grips.room-e * root.dot >= 20px ? root.grip-size : 0px;
                x: grid.grip-held == 0 ? grid.held-x : self.at-x;
                y: grid.grip-held == 0 ? grid.held-y : self.at-y;
                width: grid.grip-held == 0 ? grid.held-w : self.size;
                height: grid.grip-held == 0 ? grid.held-h : self.size;
                mouse-cursor: MouseCursor.ew-resize;
                pointer-event(event) => {
                    grid.grip-event(0, event.kind, event.button,
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                }
                moved => {
                    if (self.pressed) {
                        grid.grip-moved(self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                    }
                }
                Rectangle {
                    x: parent.at-x - parent.x;
                    y: parent.at-y - parent.y;
                    width: parent.size;
                    height: parent.size;
                    background: #ffffff;
                    border-width: 1phx;
                    border-color: #1a6dd4;
                    accessible-role: none;
                }
            }
            grip-s := TouchArea {
                property <length> at-x: grid.box-x + grid.box-w / 2 - root.grip-size / 2;
                property <length> at-y: grid.box-y + grid.box-h + root.grip-gap;
                property <length> size: grid.grips-on && root.grips.room-s * root.dot >= 20px ? root.grip-size : 0px;
                x: grid.grip-held == 1 ? grid.held-x : self.at-x;
                y: grid.grip-held == 1 ? grid.held-y : self.at-y;
                width: grid.grip-held == 1 ? grid.held-w : self.size;
                height: grid.grip-held == 1 ? grid.held-h : self.size;
                mouse-cursor: MouseCursor.ns-resize;
                pointer-event(event) => {
                    grid.grip-event(1, event.kind, event.button,
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                }
                moved => {
                    if (self.pressed) {
                        grid.grip-moved(self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                    }
                }
                Rectangle {
                    x: parent.at-x - parent.x;
                    y: parent.at-y - parent.y;
                    width: parent.size;
                    height: parent.size;
                    background: #ffffff;
                    border-width: 1phx;
                    border-color: #1a6dd4;
                    accessible-role: none;
                }
            }
            grip-se := TouchArea {
                property <length> at-x: grid.box-x + grid.box-w + root.grip-gap;
                property <length> at-y: grid.box-y + grid.box-h + root.grip-gap;
                property <length> size: grid.grips-on && root.grips.room-se * root.dot >= 20px ? root.grip-size : 0px;
                x: grid.grip-held == 2 ? grid.held-x : self.at-x;
                y: grid.grip-held == 2 ? grid.held-y : self.at-y;
                width: grid.grip-held == 2 ? grid.held-w : self.size;
                height: grid.grip-held == 2 ? grid.held-h : self.size;
                mouse-cursor: MouseCursor.nwse-resize;
                pointer-event(event) => {
                    grid.grip-event(2, event.kind, event.button,
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                }
                moved => {
                    if (self.pressed) {
                        grid.grip-moved(self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                    }
                }
                Rectangle {
                    x: parent.at-x - parent.x;
                    y: parent.at-y - parent.y;
                    width: parent.size;
                    height: parent.size;
                    background: #ffffff;
                    border-width: 1phx;
                    border-color: #1a6dd4;
                    accessible-role: none;
                }
            }
        }
    }

    // So a pane above can put the keyboard into the canvas.
    public function focus-canvas() {
        keys.focus();
    }
}
