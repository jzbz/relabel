import { Designer, DefaultWindow } from "../shell.slint";
import { ElRow, InsSlot, Tool, Grips, SizePreset, IssueRow, ChoiceRow } from "../types.slint";

export { ElRow, InsSlot, Tool, Grips, SizePreset, IssueRow, ChoiceRow, DefaultWindow }

// The application's shell in a window of its own, compiled a second time with
// debug info so that ElementHandle can see the element tree. It imports the
// shipped shell rather than restating it, so a test drives the same F6, Tab and
// Ctrl+Z code the application runs, and the pane it measures is the pane an
// operator gets.
//
// Fixed at the application window's preferred size, because what the pane costs
// the canvas beside it is measured against that size. Read from the shell's
// global rather than copied, so the two cannot drift; the testing backend does
// not size a window to its preferred size (testing_backend.rs:385-386). Exported
// so a test can read the same numbers through `global::<DefaultWindow>()`.
export component InsProbe inherits Window {
    in property <image> plane <=> shell.plane;
    in property <int> plane-px-w <=> shell.plane-px-w;
    in property <int> plane-px-h <=> shell.plane-px-h;
    in property <int> dots-x <=> shell.dots-x;
    in property <int> dots-y <=> shell.dots-y;
    in property <[ElRow]> rows <=> shell.rows;
    in property <int> selected <=> shell.selected;
    in property <int> zoom <=> shell.zoom;
    in property <Grips> grips <=> shell.grips;
    in property <[Tool]> tools <=> shell.tools;
    in property <[InsSlot]> ins-slots <=> shell.ins-slots;
    in property <string> ins-heading <=> shell.ins-heading;
    in property <bool> ins-shown <=> shell.ins-shown;
    in property <string> ins-captions <=> shell.ins-captions;
    in property <int> pan-x <=> shell.pan-x;
    in property <int> pan-y <=> shell.pan-y;
    in property <int> scene-x <=> shell.scene-x;
    in property <int> scene-y <=> shell.scene-y;
    in property <int> scene-w <=> shell.scene-w;
    in property <int> scene-h <=> shell.scene-h;
    in property <string> zoom-says <=> shell.zoom-says;
    out property <int> view-px-w <=> shell.view-px-w;
    out property <int> view-px-h <=> shell.view-px-h;
    out property <int> grip-reach-px <=> shell.grip-reach-px;
    out property <bool> pointer-down <=> shell.pointer-down;
    in property <string> status <=> shell.status;
    in property <[Tool]> file-tools <=> shell.file-tools;
    in property <[SizePreset]> new-presets <=> shell.new-presets;
    in property <string> new-note <=> shell.new-note;
    in property <string> printer-line <=> shell.printer-line;
    in property <string> preview-verdict <=> shell.preview-verdict;
    in property <string> preview-step <=> shell.preview-step;
    in property <image> preview-plane <=> shell.preview-plane;
    in property <int> preview-plane-px-w <=> shell.preview-plane-px-w;
    in property <int> preview-plane-px-h <=> shell.preview-plane-px-h;
    in property <string> preview-plane-says <=> shell.preview-plane-says;
    in property <string> preview-facts <=> shell.preview-facts;
    in property <[IssueRow]> preview-issues <=> shell.preview-issues;
    in property <[ChoiceRow]> preview-choices <=> shell.preview-choices;
    in property <string> preview-primary <=> shell.preview-primary;
    in property <string> preview-primary-says <=> shell.preview-primary-says;
    in property <bool> preview-primary-shown <=> shell.preview-primary-shown;
    in property <bool> preview-primary-default <=> shell.preview-primary-default;
    in property <string> preview-close-says <=> shell.preview-close-says;
    in property <string> preview-copies-start <=> shell.preview-copies-start;
    in property <string> preview-copies-says <=> shell.preview-copies-says;
    in property <bool> preview-copies-shown <=> shell.preview-copies-shown;
    in property <string> preview-print-face <=> shell.preview-print-face;
    in property <string> preview-print-says <=> shell.preview-print-says;
    in property <bool> preview-print-shown <=> shell.preview-print-shown;
    in property <bool> preview-job-shown <=> shell.preview-job-shown;
    in property <float> preview-job-done <=> shell.preview-job-done;
    in property <string> preview-job-says <=> shell.preview-job-says;
    in property <string> preview-image-label <=> shell.preview-image-label;
    in property <int> preview-focus-to <=> shell.preview-focus-to;
    in property <int> preview-focus-serial <=> shell.preview-focus-serial;

    callback select(id: int);
    callback begin-move(id: int);
    callback move-to(id: int, x: int, y: int);
    callback end-move(committed: bool);
    callback nudge(id: int, dx: int, dy: int, coarse: bool);
    callback set-say(id: int, value: string);
    callback undo();
    callback redo();
    callback begin-resize(id: int, grip: int);
    callback resize-to(id: int, right: int, bottom: int);
    callback add(kind: int) -> bool;
    callback kind-of-key(text: string) -> int;
    callback delete-element(id: int) -> bool;
    callback field-edited(field: int, value: string);
    callback field-commit();
    callback field-stepped(field: int, by: int);
    callback field-action(field: int);
    // Rust to Rust: the edit bar's Image tool asks for artwork through it, since
    // the file commands that ask are wired after the edit bar. -1 is a new image.
    callback import-artwork(id: int);
    callback zoom-step(by: int);
    callback zoom-one();
    callback zoom-fit();
    callback zoom-wheel(travel: float, at-x: float, at-y: float);
    callback pan-by(dx: float, dy: float);
    callback pan-to(x: int, y: int);
    callback view-resized();
    callback file-command(token: int);
    callback file-of-key(text: string, shift: bool) -> int;
    // No chord is a file command until Rust says which are. A callback with no
    // handler answers 0 (i-slint-core callbacks.rs:34-42), which is New's token, so
    // a window whose files are not wired - most test probes - would take every
    // Control chord that reaches this far for New, the add chords among them.
    // `file::wire` replaces this.
    file-of-key(text, shift) => {
        return -1;
    }
    callback unsaved-reply(answer: int);
    callback new-feed-edited(text: string);
    callback new-check(text: string) -> bool;
    callback new-make(text: string);
    callback new-preset(token: int);
    callback new-cancel();
    callback preview-act(what: int);
    callback preview-choose(index: int);
    callback preview-copies-edited(text: string);

    public function show-fields() {
        shell.show-fields();
    }

    public function focus-canvas() {
        shell.focus-canvas();
    }

    public function show-unsaved(question: string) {
        shell.show-unsaved(question);
    }

    public function show-new(printer: string, across: string, about: string, feed: string, hint: string) {
        shell.show-new(printer, across, about, feed, hint);
    }

    public function close-file-popups() {
        shell.close-file-popups();
    }

    public function show-preview() {
        shell.show-preview();
    }

    // The testing backend ignores a window's title (testing_backend.rs:404-409), so
    // a test reads this property instead; bound as the application's is.
    in property <string> doc-title: "relabel";
    title: root.doc-title;

    width: DefaultWindow.width;
    height: DefaultWindow.height;
    background: #ffffff;

    shell := Designer {
        // A component with no base of its own is placed at its preferred size
        // and centred, which would leave the canvas column no width at all.
        width: 100%;
        height: 100%;
        select(id) => { root.select(id); }
        begin-move(id) => { root.begin-move(id); }
        move-to(id, x, y) => { root.move-to(id, x, y); }
        end-move(c) => { root.end-move(c); }
        nudge(id, dx, dy, c) => { root.nudge(id, dx, dy, c); }
        set-say(id, v) => { root.set-say(id, v); }
        undo() => { root.undo(); }
        redo() => { root.redo(); }
        begin-resize(id, g) => { root.begin-resize(id, g); }
        resize-to(id, r, b) => { root.resize-to(id, r, b); }
        add(k) => { return root.add(k); }
        kind-of-key(t) => { return root.kind-of-key(t); }
        delete-element(id) => { return root.delete-element(id); }
        field-edited(f, v) => { root.field-edited(f, v); }
        field-commit() => { root.field-commit(); }
        field-stepped(f, b) => { root.field-stepped(f, b); }
        field-action(f) => { root.field-action(f); }
        zoom-step(by) => { root.zoom-step(by); }
        zoom-one() => { root.zoom-one(); }
        zoom-fit() => { root.zoom-fit(); }
        zoom-wheel(t, x, y) => { root.zoom-wheel(t, x, y); }
        pan-by(dx, dy) => { root.pan-by(dx, dy); }
        pan-to(x, y) => { root.pan-to(x, y); }
        view-resized() => { root.view-resized(); }
        file-command(t) => { root.file-command(t); }
        file-of-key(t, s) => { return root.file-of-key(t, s); }
        unsaved-reply(a) => { root.unsaved-reply(a); }
        new-feed-edited(t) => { root.new-feed-edited(t); }
        new-check(t) => { return root.new-check(t); }
        new-make(t) => { root.new-make(t); }
        new-preset(t) => { root.new-preset(t); }
        new-cancel() => { root.new-cancel(); }
        preview-act(w) => { root.preview-act(w); }
        preview-choose(i) => { root.preview-choose(i); }
        preview-copies-edited(t) => { root.preview-copies-edited(t); }
    }
}
