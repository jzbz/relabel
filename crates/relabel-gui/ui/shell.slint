import { LabelCanvas } from "canvas.slint";
import { Inspector } from "inspector.slint";
import { ZoomBar, Scroller } from "zoom.slint";
import { ElRow, InsSlot } from "types.slint";

// The size the application opens at, which its probe is fixed at too, so the two
// cannot drift. Wide enough for a 40 mm label at two device pixels to the dot beside
// the pane at scale 1: 640 of view, the pane's 442 to 451, 36 of padding and spacing
// and a 12 px bar, rounded up for other fonts. Tall enough for the tallest kind's
// pane beside a two-line status line.
export global DefaultWindow {
    out property <length> width: 1200px;
    out property <length> height: 640px;
}

// The two panes, the keys that move between them, the view round the canvas, and
// the status line.
//
// A component of its own rather than the body of the application window,
// because it is behaviour - F6 between the panes, Ctrl+Z from inside a field,
// the Tab order across both - and behaviour only the application window carried
// could not be tested: the test probe is what is compiled with debug info, and a
// probe that restated this would drift from it. Both windows are a thin `Window`
// round this component, so they run the same code.
export component Designer {
    // --- the canvas, forwarded unchanged ---
    in property <image> plane <=> canvas.plane;
    in property <int> plane-px-w <=> canvas.plane-px-w;
    in property <int> plane-px-h <=> canvas.plane-px-h;
    in property <int> dots-x <=> canvas.dots-x;
    in property <int> dots-y <=> canvas.dots-y;
    in property <[ElRow]> rows <=> canvas.rows;
    in property <int> selected <=> canvas.selected;
    in property <int> zoom <=> canvas.zoom;

    // --- the inspector ---
    in property <[InsSlot]> ins-slots <=> inspector.slots;
    in property <string> ins-heading <=> inspector.heading;
    in property <bool> ins-shown <=> inspector.shown;
    in property <string> ins-captions <=> inspector.captions;

    in property <string> status;

    // --- the view, pushed and read by crate::view ---
    // The pan, in whole device pixels from the canvas origin.
    in property <int> pan-x;
    in property <int> pan-y;
    // The pannable extent in device pixels, which the scroll bars have no other
    // source for.
    in property <int> scene-x;
    in property <int> scene-y;
    in property <int> scene-w;
    in property <int> scene-h;
    in property <string> zoom-says <=> bar.says;
    // Whole device pixels less the half pixel the dot grid's anchor can add
    // (canvas.slint, `grid`), so a Fit that fills the view is not a pixel too wide.
    // Read by Rust when needed: a layout property is evaluated when read.
    out property <int> view-px-w: Math.floor(port.width / 1phx - 0.5);
    out property <int> view-px-h: Math.floor(port.height / 1phx - 0.5);
    out property <bool> pointer-down: canvas.pointer-down;

    callback select(id: int);
    callback begin-move(id: int);
    callback move-to(id: int, x: int, y: int);
    callback end-move(committed: bool);
    callback nudge(id: int, dx: int, dy: int, coarse: bool);
    callback set-say(id: int, value: string);
    callback undo();
    callback redo();

    callback field-edited(field: int, value: string);
    callback field-commit();
    callback field-stepped(field: int, by: int);

    callback zoom-step(by: int);
    callback zoom-one();
    callback zoom-fit();
    // Logical pixels of wheel travel, and the pointer in device pixels from the
    // view's top-left.
    callback zoom-wheel(travel: float, at-x: float, at-y: float);
    // Device pixels.
    callback pan-by(dx: float, dy: float);
    callback pan-to(x: int, y: int);
    callback view-resized();

    // On the device size rather than on `width`: a move to a display of another
    // scale changes the first and not the second (measured, reach run4.log). Late by
    // one event-loop turn, which is only ever used to refit and keep, never to reveal.
    changed view-px-w => {
        root.view-resized();
    }
    changed view-px-h => {
        root.view-resized();
    }

    // Called from Rust after every outcome, never before `ins-slots` is written.
    public function show-fields() {
        inspector.show-fields();
    }

    // So the window opens with the keyboard somewhere. Without it F6 below does
    // nothing at startup: the capture list is built from the focused item's
    // ancestor chain (window.rs:1084-1104), and with no focus item it is empty.
    public function focus-canvas() {
        canvas.focus-canvas();
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // F6 cycles the two panes. Captured rather than handled, because a
        // capture is offered to every scope from the window down to the focused
        // item, so this sees the key while the keyboard is inside a field; and
        // `focus-on-tab-navigation: false` so it costs no Tab stop of its own.
        // Tab alone is not enough: on a fifty-element label the inspector is
        // fifty Tab stops past the selected element.
        panes := FocusScope {
            focus-on-tab-navigation: false;
            focus-on-click: false;
            // All the height the status line does not need, whatever the pane
            // holds. Sized by its contents instead, the row grew when a selection
            // first showed the pane, and the canvas centred in it jumped down
            // under the pointer in the middle of the press that selected.
            vertical-stretch: 1;
            capture-key-pressed(event) => {
                if (event.text == Key.F6) {
                    // Which way to go is read from focus, not remembered. Tab,
                    // Shift+Tab, a click and an assistive technology all carry
                    // the keyboard across the pane boundary without F6, and a
                    // toggle only F6 wrote was wrong after any of them.
                    if (root.ins-shown && !inspector.has-keyboard) {
                        inspector.take-keyboard();
                    } else {
                        // The selection is not changed on the way out: a pane
                        // hand-off is not an edit, and deselecting would empty
                        // the pane the operator is trying to leave.
                        canvas.focus-canvas();
                    }
                    return EventResult.accept;
                }
                // Undo and redo from anywhere in the window. The canvas handles
                // these in its own scope (canvas.slint), which a field in the
                // inspector is not inside, so without this they would do nothing
                // while the keyboard is in the pane. A capture runs before the
                // focused item's own handler, so in this window the canvas's
                // copy never sees them; it still serves the canvas probe, which
                // has no shell.
                //
                // Both cases of the letter: a keyboard delivers Ctrl+Shift+Z with
                // the shifted character, because winit's logical key keeps every
                // modifier but Ctrl, and Slint's own shortcut table matches "z" |
                // "Z" for Redo for that reason (i-slint-core input.rs:991-996).
                // Missed here, the key reaches a field's own text-level redo
                // instead of the document's.
                if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                    if (event.modifiers.shift) {
                        root.redo();
                    } else {
                        root.undo();
                    }
                    return EventResult.accept;
                }
                // Ctrl+Y, Redo in that table on Windows. Taken on every platform:
                // nothing else in this window binds it, and a field would
                // otherwise run its own redo there too.
                if (event.modifiers.control && !event.modifiers.shift
                    && (event.text == "y" || event.text == "Y")) {
                    root.redo();
                    return EventResult.accept;
                }
                // The zoom, from anywhere in the window, for Ctrl+Z's reason. Both
                // characters of each key: a keyboard sends Ctrl+Shift+= as "+" and
                // Ctrl+Shift+- as "_" with Shift still held (measured on X11,
                // logs/x11-keys.log). A capture sees them from inside a field, which
                // ignores Control keys anyway (items/text.rs:1057-1059), so a field
                // never receives these characters. On macOS Cmd arrives as control
                // (i-slint-backend-winit event_loop.rs:258).
                if (event.modifiers.control && (event.text == "=" || event.text == "+")) {
                    root.zoom-step(1);
                    return EventResult.accept;
                }
                if (event.modifiers.control && (event.text == "-" || event.text == "_")) {
                    root.zoom-step(-1);
                    return EventResult.accept;
                }
                if (event.modifiers.control && event.text == "1") {
                    root.zoom-one();
                    return EventResult.accept;
                }
                if (event.modifiers.control && event.text == "0") {
                    root.zoom-fit();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            // The arrows, for the selected element, while the keyboard is on the
            // canvas surface rather than on that element's own scope - which is
            // where F6 back leaves it, because the shell cannot reach into the
            // canvas's repeater to focus one row. Handled on the way back up
            // rather than captured, so an arrow gets here only after the element
            // that has the keyboard, or the field, has turned it down; and never
            // while a field has the keyboard, where an arrow the field ignored is
            // not a request to move anything. Rust refuses a locked element.
            key-pressed(event) => {
                if (inspector.has-keyboard || root.selected < 0) {
                    return EventResult.reject;
                }
                if (event.text == Key.LeftArrow) {
                    root.nudge(root.selected, -1, 0, event.modifiers.shift);
                    return EventResult.accept;
                }
                if (event.text == Key.RightArrow) {
                    root.nudge(root.selected, 1, 0, event.modifiers.shift);
                    return EventResult.accept;
                }
                if (event.text == Key.UpArrow) {
                    root.nudge(root.selected, 0, -1, event.modifiers.shift);
                    return EventResult.accept;
                }
                if (event.text == Key.DownArrow) {
                    root.nudge(root.selected, 0, 1, event.modifiers.shift);
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;

                    // Above the view, so the bar takes its height from the canvas
                    // column and none from the pane.
                    bar := ZoomBar {
                        fit => { root.zoom-fit(); }
                        one => { root.zoom-one(); }
                        step(by) => { root.zoom-step(by); }
                    }

                    // The canvas keeps a Rectangle of its own: it sets its width from
                    // the label and is routinely wider than the window.
                    column := Rectangle {
                        vertical-stretch: 1;
                        property <length> bar-size: 12px;
                        // Positioned, so none of this is counted in the column's own
                        // size: a 1280-pixel canvas still cannot push the pane out of
                        // the window (12c's reason, kept). The bars' room is reserved
                        // whether or not they are drawn, so a bar appearing never
                        // resizes the port.
                        //
                        // An ancestor of every element's TouchArea. An element rejects
                        // a wheel by default, so the wheel passes out to here
                        // (input_items.rs:193-212, input.rs:1681-1695); while pressed
                        // the element answers GrabMouse and keeps it
                        // (input_items.rs:198-199), so nothing pans under a drag. No
                        // Flickable: it would delay every press, or intercept
                        // Ctrl+wheel for 800 ms after its own scroll (flickable.rs:376,
                        // :726-758).
                        wheel := TouchArea {
                            x: 0px;
                            y: 0px;
                            width: Math.max(0px, parent.width - parent.bar-size);
                            height: Math.max(0px, parent.height - parent.bar-size);
                            scroll-event(e) => {
                                if (e.modifiers.control) {
                                    root.zoom-wheel(e.delta-y / 1px, self.mouse-x / 1phx, self.mouse-y / 1phx);
                                } else if (e.modifiers.shift && e.delta-x == 0px) {
                                    // A vertical wheel with Shift held pans across where
                                    // the platform has not already turned it; macOS has,
                                    // and its travel then arrives horizontal and takes
                                    // the plain path below.
                                    root.pan-by(-e.delta-y / 1phx, 0);
                                } else {
                                    root.pan-by(-e.delta-x / 1phx, -e.delta-y / 1phx);
                                }
                                return EventResult.accept;
                            }

                            port := Rectangle {
                                width: 100%;
                                height: 100%;
                                background: #f4f4f4;
                                // Clipped here rather than by the window, so an oversized
                                // plane does not paint under the fields beside it.
                                clip: true;

                                canvas := LabelCanvas {
                                    // Top-left on both axes, at the pan. Anchored rather
                                    // than centred: a centred canvas wider or taller
                                    // than its view loses the label's start off both
                                    // edges, and moves whenever the column's size does.
                                    // A pan of 0 always means the label's origin, which
                                    // Fit, the reveal and the anchors all use.
                                    x: -root.pan-x * 1phx;
                                    y: -root.pan-y * 1phx;
                                    viewed: true;
                                    seen-x: root.pan-x * 1phx;
                                    seen-y: root.pan-y * 1phx;
                                    seen-width: port.width;
                                    seen-height: port.height;
                                    // Every way the keyboard can leave the pane for the
                                    // canvas ends in one of these two, and the next field
                                    // it enters is an arrival rather than a return
                                    // (inspector.slint). Selecting commits what was typed
                                    // on the Rust side.
                                    select(id) => {
                                        inspector.keyboard-at = -1;
                                        root.select(id);
                                    }
                                    // Bare canvas selects nothing, so nothing else would
                                    // finish what was typed.
                                    surface-focused() => {
                                        inspector.keyboard-at = -1;
                                        root.field-commit();
                                    }
                                    begin-move(id) => { root.begin-move(id); }
                                    move-to(id, x, y) => { root.move-to(id, x, y); }
                                    end-move(c) => { root.end-move(c); }
                                    nudge(id, dx, dy, c) => { root.nudge(id, dx, dy, c); }
                                    set-say(id, v) => { root.set-say(id, v); }
                                    undo() => { root.undo(); }
                                    redo() => { root.redo(); }
                                }
                            }
                        }

                        Scroller {
                            x: 0px;
                            y: wheel.height;
                            width: wheel.width;
                            height: parent.bar-size;
                            horizontal: true;
                            lo: root.scene-x;
                            whole: root.scene-w;
                            shown: root.view-px-w;
                            offset: root.pan-x;
                            to(at) => { root.pan-to(at, root.pan-y); }
                        }
                        Scroller {
                            x: wheel.width;
                            y: 0px;
                            width: parent.bar-size;
                            height: wheel.height;
                            horizontal: false;
                            lo: root.scene-y;
                            whole: root.scene-h;
                            shown: root.view-px-h;
                            offset: root.pan-y;
                            to(at) => { root.pan-to(root.pan-x, at); }
                        }
                    }
                }

                inspector := Inspector {
                    field-edited(f, v) => { root.field-edited(f, v); }
                    field-commit() => { root.field-commit(); }
                    field-stepped(f, b) => { root.field-stepped(f, b); }
                }
            }
        }

        status-row := Rectangle {
            vertical-stretch: 0;
            // Exactly two lines, whatever it holds. A note written inside a press - the
            // refusal a staged field's commit makes when the press selects - must not
            // change the panes' height under the pointer, for the reason the pane's
            // width must not. One line's height is measured rather than chosen.
            height: 2 * line.preferred-height;
            line := Text {
                x: 0px;
                y: 0px;
                text: " ";
                visible: false;
                accessible-role: AccessibleRole.none;
            }
            Text {
                width: parent.width;
                height: parent.height;
                text: root.status;
                wrap: word-wrap;
                // Elided past two lines on screen (textlayout/sharedparley.rs:945); the
                // whole sentence is still the value the live region announces.
                overflow: elide;
                accessible-role: AccessibleRole.text;
                accessible-label: "Status";
                accessible-value: root.status;
                // The only channel a refusal has, and the reason it needs no modal: a
                // live region is announced when it changes. Polite, because a refused
                // field edit blocks nothing and the field itself already holds the
                // truth.
                accessible-live-region: AccessibleLiveness.polite;
            }
        }
    }
}
