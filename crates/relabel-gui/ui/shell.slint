import { LabelCanvas } from "canvas.slint";
import { Inspector } from "inspector.slint";
import { ZoomBar, Scroller } from "zoom.slint";
import { EditBar, FileBar } from "tools.slint";
import { UnsavedQuestion, NewLabelPane } from "files.slint";
import { PreviewPane } from "print.slint";
import { ElRow, InsSlot, Tool, Grips, SizePreset, IssueRow, ChoiceRow } from "types.slint";

// The size the application opens at, which its probe is fixed at too, so the two
// cannot drift. Wide enough for a 40 mm label at two device pixels to the dot beside
// the pane at scale 1: 640 of view, the pane's 442 to 451, 36 of padding and spacing
// and a 12 px bar, rounded up for other fonts. Tall enough for the tallest kind's
// pane beside a two-line status line, plus the File bar's row, 28 px and 8 px of
// spacing, so the view keeps the 709 × 525 the view tests are stated against.
export global DefaultWindow {
    out property <length> width: 1200px;
    out property <length> height: 676px;
}

// The two panes, the keys that move between them, the view round the canvas, and
// the status line.
//
// A component of its own rather than the body of the application window,
// because it is behaviour - F6 between the panes, Ctrl+Z from inside a field,
// the Tab order across both - and behaviour only the application window carried
// could not be tested: the test probe is what is compiled with debug info, and a
// probe that restated this would drift from it. Both windows are a thin `Window`
// round this component, so they run the same code.
export component Designer {
    // --- the canvas, forwarded unchanged ---
    in property <image> plane <=> canvas.plane;
    in property <int> plane-px-w <=> canvas.plane-px-w;
    in property <int> plane-px-h <=> canvas.plane-px-h;
    in property <int> dots-x <=> canvas.dots-x;
    in property <int> dots-y <=> canvas.dots-y;
    in property <[ElRow]> rows <=> canvas.rows;
    in property <int> selected <=> canvas.selected;
    in property <int> zoom <=> canvas.zoom;
    in property <Grips> grips <=> canvas.grips;

    // --- the edit bar, pushed once by crate::edit ---
    in property <[Tool]> tools <=> edit-bar.tools;

    // --- the files, pushed by crate::file ---
    // The File bar's five buttons, pushed once.
    in property <[Tool]> file-tools <=> file-bar.tools;
    // The New label pane's presets, and what the length typed so far comes to,
    // pushed when the pane opens and on every edit.
    in property <[SizePreset]> new-presets;
    in property <string> new-note;
    // What the popups show, set by the functions that open them.
    private property <string> unsaved-question;
    private property <string> new-printer;
    private property <string> new-across;
    private property <string> new-about;
    private property <string> new-feed-start;
    private property <string> new-hint;

    // --- the printer, pushed by crate::print ---
    // What is connected, beside the File bar.
    in property <string> printer-line;
    // The Preview pane's contents, pushed before it opens and whenever they change
    // while it is open. Every sentence is `proof`'s or `printing`'s.
    in property <string> preview-verdict;
    in property <string> preview-step;
    in property <image> preview-plane;
    in property <int> preview-plane-px-w;
    in property <int> preview-plane-px-h;
    in property <string> preview-plane-says;
    in property <string> preview-facts;
    in property <[IssueRow]> preview-issues;
    in property <[ChoiceRow]> preview-choices;
    in property <string> preview-primary;
    in property <string> preview-primary-says;
    in property <bool> preview-primary-shown;
    in property <bool> preview-primary-default;
    in property <string> preview-close-says;
    in property <int> preview-focus-to;
    in property <int> preview-focus-serial;

    // --- the inspector ---
    in property <[InsSlot]> ins-slots <=> inspector.slots;
    in property <string> ins-heading <=> inspector.heading;
    in property <bool> ins-shown <=> inspector.shown;
    in property <string> ins-captions <=> inspector.captions;

    in property <string> status;

    // --- the view, pushed and read by crate::view ---
    // The pan, in whole device pixels from the canvas origin.
    in property <int> pan-x;
    in property <int> pan-y;
    // The pannable extent in device pixels, which the scroll bars have no other
    // source for.
    in property <int> scene-x;
    in property <int> scene-y;
    in property <int> scene-w;
    in property <int> scene-h;
    in property <string> zoom-says <=> bar.says;
    // Whole device pixels less the half pixel the dot grid's anchor can add
    // (canvas.slint, `grid`), so a Fit that fills the view is not a pixel too wide.
    // Read by Rust when needed: a layout property is evaluated when read.
    out property <int> view-px-w: Math.floor(port.width / 1phx - 0.5);
    out property <int> view-px-h: Math.floor(port.height / 1phx - 0.5);
    // How far past the selected frame's far edges a pan reaches for its grips
    // (canvas.slint), read by Rust with the view's size.
    out property <int> grip-reach-px: canvas.grip-reach-px;
    out property <bool> pointer-down: canvas.pointer-down;

    callback select(id: int);
    callback begin-move(id: int);
    callback move-to(id: int, x: int, y: int);
    callback end-move(committed: bool);
    callback nudge(id: int, dx: int, dy: int, coarse: bool);
    callback set-say(id: int, value: string);
    callback undo();
    callback redo();
    callback begin-resize(id: int, grip: int);
    callback resize-to(id: int, right: int, bottom: int);

    // A new element of the kind with this token. True when one was added, so the
    // keyboard is moved only then: a refused add leaves it where the operator was.
    callback add(kind: int) -> bool;
    // The kind token whose chord this key's text is, or -1. Rust's, so the letters
    // and the descriptions the buttons announce are spelled in one place.
    callback kind-of-key(text: string) -> int;
    // Delete this element, or say that nothing is selected when it is -1. True when
    // nothing is selected afterwards, which is when the keyboard may have lost its
    // row: see `remove-selected` for why the answer comes back rather than being read.
    callback delete-element(id: int) -> bool;

    callback field-edited(field: int, value: string);
    callback field-commit();
    callback field-stepped(field: int, by: int);

    callback zoom-step(by: int);
    callback zoom-one();
    callback zoom-fit();
    // Logical pixels of wheel travel, and the pointer in device pixels from the
    // view's top-left.
    callback zoom-wheel(travel: float, at-x: float, at-y: float);
    // Device pixels of wheel or trackpad travel, turned across here only for Shift;
    // with nothing across and no room down Rust turns it across too
    // (view::wheel_travel).
    callback pan-by(dx: float, dy: float);
    callback pan-to(x: int, y: int);
    callback view-resized();

    // A File bar token: `filing::Want`'s. Every route - a button, its default
    // action, a chord - comes here, and Rust decides everything else.
    callback file-command(token: int);
    // The File bar token whose chord this key is with Control held, or -1. Rust's,
    // for `kind-of-key`'s reason; Shift is passed apart from the character because
    // Save as is told from Save by Shift, never by the letter's case.
    callback file-of-key(text: string, shift: bool) -> int;
    // The answer to the question about unsaved work: `filing::Reply`'s token.
    callback unsaved-reply(answer: int);
    callback new-feed-edited(text: string);
    callback new-check(text: string) -> bool;
    callback new-make(text: string);
    callback new-preset(token: int);
    callback new-cancel();
    // The Preview pane: 0 its primary slot, 1 Close; and an offered printer.
    callback preview-act(what: int);
    callback preview-choose(index: int);

    // On the device size rather than on `width`: a move to a display of another
    // scale changes the first and not the second (measured, reach run4.log). Late by
    // one event-loop turn, which is only ever used to refit and keep, never to reveal.
    changed view-px-w => {
        root.view-resized();
    }
    changed view-px-h => {
        root.view-resized();
    }
    // A change of scale that leaves the view's device size alone still changes the
    // grips' reach, and so the scene: the bars are pushed again, so room down and the
    // drawn bar cannot disagree.
    changed grip-reach-px => {
        root.view-resized();
    }

    // Called from Rust after every outcome, never before `ins-slots` is written.
    public function show-fields() {
        inspector.show-fields();
    }

    // So the window opens with the keyboard somewhere. Without it F6 below does
    // nothing at startup: the capture list is built from the focused item's
    // ancestor chain (window.rs:1084-1104), and with no focus item it is empty.
    public function focus-canvas() {
        canvas.focus-canvas();
    }

    // A chord's file command, as `file-of-key` answered it. Taken whenever it names
    // one, for `add-by-key`'s reason.
    function file-by-key(token: int) -> bool {
        if (token < 0) {
            return false;
        }
        root.file-command(token);
        return true;
    }

    // Called from Rust, which has decided the question and its words.
    public function show-unsaved(question: string) {
        root.unsaved-question = question;
        unsaved.show();
    }

    // Called from Rust with the pane's lines, once it has pushed the presets' model
    // and the note; the field is filled once, when the pane opens.
    public function show-new(printer: string, across: string, about: string, feed: string, hint: string) {
        root.new-printer = printer;
        root.new-across = across;
        root.new-about = about;
        root.new-feed-start = feed;
        root.new-hint = hint;
        new-pane.show();
    }

    // Called from Rust once the pane's contents are pushed.
    public function show-preview() {
        preview-pane.show();
    }

    // Called from Rust before it shows the question, the preview or closes the
    // window: a close abandons the New label pane and the preview, and no popup
    // ever opens over another.
    public function close-file-popups() {
        unsaved.close();
        new-pane.close();
        preview-pane.close();
    }

    // Every route that adds an element: a button, its default action and a chord.
    //
    // The new element is selected and the keyboard goes to the canvas surface, where
    // the shell's arrows move the selection, Delete deletes it and F6 enters its
    // fields. After Rust has returned, so the document is not borrowed when the
    // surface's arrival commits whatever a field was holding.
    function add-kind(kind: int) {
        if (root.add(kind)) {
            canvas.focus-canvas();
        }
    }

    // A chord's kind, as `kind-of-key` answered it. Any chord that names a kind is
    // taken, added or not: a field ignores Control keys anyway, and a refusal is said
    // on the status line.
    function add-by-key(kind: int) -> bool {
        if (kind < 0) {
            return false;
        }
        root.add-kind(kind);
        return true;
    }

    // An element's row holds the keyboard only while it is the selection, because
    // selection follows focus. So an empty selection after a command is exactly when
    // the row or the field that held the keyboard may be gone, and with no live focus
    // item no capture runs and every chord in this window goes dead
    // (i-slint-core window.rs:1076-1082). The canvas surface takes it back. From a
    // capture the dying row is still referenced until the capture returns
    // (window.rs:1084-1105); from a button its weak focus is simply dead; either way
    // `focus()` lands.
    //
    // Whether the selection is empty comes back from the callback rather than being
    // read from `selected` afterwards. The compiler reads a property that a function
    // uses twice into one local at the top of the function, before the callback runs
    // (i-slint-compiler passes/deduplicate_property_read.rs:97-122; only callback
    // handlers are exempt, :15-19). Measured: the second read of `selected` here was
    // the id just deleted, and the keyboard stayed on the freed row. `history` reads
    // it once, after the call.
    function remove-selected() {
        if (root.delete-element(root.selected)) {
            canvas.focus-canvas();
        }
    }

    // Undo or redo, for `remove-selected`'s reason: undoing an add, or redoing a
    // delete, takes away the selected element and its row. `selected` is read once
    // and only after the command, so the read is the one Rust has just written; a
    // second read added before the command would be hoisted above it.
    function history(redo: bool) {
        if (redo) {
            root.redo();
        } else {
            root.undo();
        }
        if (root.selected < 0) {
            canvas.focus-canvas();
        }
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // F6 cycles the two panes. Captured rather than handled, because a
        // capture is offered to every scope from the window down to the focused
        // item, so this sees the key while the keyboard is inside a field; and
        // `focus-on-tab-navigation: false` so it costs no Tab stop of its own.
        // Tab alone is not enough: on a fifty-element label the inspector is
        // fifty Tab stops past the selected element.
        panes := FocusScope {
            focus-on-tab-navigation: false;
            focus-on-click: false;
            // All the height the status line does not need, whatever the pane
            // holds. Sized by its contents instead, the row grew when a selection
            // first showed the pane, and the canvas centred in it jumped down
            // under the pointer in the middle of the press that selected.
            vertical-stretch: 1;
            capture-key-pressed(event) => {
                if (event.text == Key.F6) {
                    // Which way to go is read from focus, not remembered. Tab,
                    // Shift+Tab, a click and an assistive technology all carry
                    // the keyboard across the pane boundary without F6, and a
                    // toggle only F6 wrote was wrong after any of them.
                    if (root.ins-shown && !inspector.has-keyboard) {
                        inspector.take-keyboard();
                    } else {
                        // The selection is not changed on the way out: a pane
                        // hand-off is not an edit, and deselecting would empty
                        // the pane the operator is trying to leave.
                        canvas.focus-canvas();
                    }
                    return EventResult.accept;
                }
                // Undo and redo from anywhere in the window. The canvas handles
                // these in its own scope (canvas.slint), which a field in the
                // inspector is not inside, so without this they would do nothing
                // while the keyboard is in the pane. A capture runs before the
                // focused item's own handler, so in this window the canvas's
                // copy never sees them; it still serves the canvas probe, which
                // has no shell.
                //
                // Both cases of the letter: a keyboard delivers Ctrl+Shift+Z with
                // the shifted character, because winit's logical key keeps every
                // modifier but Ctrl, and Slint's own shortcut table matches "z" |
                // "Z" for Redo for that reason (i-slint-core input.rs:991-996).
                // Missed here, the key reaches a field's own text-level redo
                // instead of the document's.
                if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                    root.history(event.modifiers.shift);
                    return EventResult.accept;
                }
                // Ctrl+Y, Redo in that table on Windows. Taken on every platform:
                // nothing else in this window binds it, and a field would
                // otherwise run its own redo there too.
                if (event.modifiers.control && !event.modifiers.shift
                    && (event.text == "y" || event.text == "Y")) {
                    root.history(true);
                    return EventResult.accept;
                }
                // The zoom, from anywhere in the window, for Ctrl+Z's reason. Both
                // characters of each key: a keyboard sends Ctrl+Shift+= as "+" and
                // Ctrl+Shift+- as "_" with Shift still held (measured on X11,
                // logs/x11-keys.log). A capture sees them from inside a field, which
                // ignores Control keys anyway (items/text.rs:1057-1059), so a field
                // never receives these characters. On macOS Cmd arrives as control
                // (i-slint-backend-winit event_loop.rs:258).
                if (event.modifiers.control && (event.text == "=" || event.text == "+")) {
                    root.zoom-step(1);
                    return EventResult.accept;
                }
                if (event.modifiers.control && (event.text == "-" || event.text == "_")) {
                    root.zoom-step(-1);
                    return EventResult.accept;
                }
                if (event.modifiers.control && event.text == "1") {
                    root.zoom-one();
                    return EventResult.accept;
                }
                if (event.modifiers.control && event.text == "0") {
                    root.zoom-fit();
                    return EventResult.accept;
                }
                // New, open, save, save as and preview: Control and N, O, S or P,
                // with Shift for Save as, from anywhere for Ctrl+Z's reason; a field
                // ignores all five (i-slint-core input.rs:972-998,
                // items/text.rs:1024-1059). Before the add chords, and Rust answers
                // -1 for Control+Shift+O, Control+Shift+N and Control+Shift+P, so Add
                // rectangle keeps its chord. A held chord
                // repeats, since the winit backend never sets `repeat`: a second Save
                // finds nothing to save, and a second Open a dialog already open.
                if (event.modifiers.control && !event.modifiers.alt
                    && root.file-by-key(root.file-of-key(event.text, event.modifiers.shift))) {
                    return EventResult.accept;
                }
                // Adding an element: Control+Shift and T, B, R, M, O or L, from
                // anywhere for Ctrl+Z's reason, after every chord above so none of
                // theirs can be taken for a kind's. A field inserts nothing for a
                // Control key (items/text.rs:1057-1059). Not Q, because Command
                // arrives as control on macOS (i-slint-backend-winit
                // event_loop.rs:257-270) and Command+Shift+Q logs out there.
                if (event.modifiers.control && event.modifiers.shift && !event.modifiers.alt
                    && root.add-by-key(root.kind-of-key(event.text))) {
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            // The arrows, for the selected element, while the keyboard is on the
            // canvas surface rather than on that element's own scope - which is
            // where F6 back leaves it, because the shell cannot reach into the
            // canvas's repeater to focus one row. Handled on the way back up
            // rather than captured, so an arrow gets here only after the element
            // that has the keyboard, or the field, has turned it down; and never
            // while a field has the keyboard, where an arrow the field ignored is
            // not a request to move anything. Rust refuses a locked element.
            key-pressed(event) => {
                if (inspector.has-keyboard) {
                    return EventResult.reject;
                }
                // Delete, and Backspace, which is what a Mac's delete key sends. Handled
                // on the way up and never captured, for the arrows' reason: an editable
                // field consumes both (items/text.rs:997-1002), and a read-only one
                // ignores them and the guard above turns them down, so neither ever
                // deletes an element from inside the pane. The rows and the canvas
                // surface turn both down, so from there they arrive here. With nothing
                // selected too, so Rust says so, as it does for the Delete element
                // button: a key that does nothing and says nothing is a key that seems
                // broken.
                if ((event.text == Key.Delete || event.text == Key.Backspace)
                    && !event.modifiers.control && !event.modifiers.alt) {
                    root.remove-selected();
                    return EventResult.accept;
                }
                if (root.selected < 0) {
                    return EventResult.reject;
                }
                if (event.text == Key.LeftArrow) {
                    root.nudge(root.selected, -1, 0, event.modifiers.shift);
                    return EventResult.accept;
                }
                if (event.text == Key.RightArrow) {
                    root.nudge(root.selected, 1, 0, event.modifiers.shift);
                    return EventResult.accept;
                }
                if (event.text == Key.UpArrow) {
                    root.nudge(root.selected, 0, -1, event.modifiers.shift);
                    return EventResult.accept;
                }
                if (event.text == Key.DownArrow) {
                    root.nudge(root.selected, 0, 1, event.modifiers.shift);
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;

                    // A row of its own, above the edit bar, so neither bar's buttons
                    // give way to the other's. DefaultWindow grows by exactly this row,
                    // which the File bar holds at a button's height: the Printer line
                    // beside it is one line and elides, so it neither widens the column
                    // nor makes the row taller.
                    HorizontalLayout {
                        spacing: 12px;
                        file-bar := FileBar {
                            horizontal-stretch: 0;
                            command(token) => { root.file-command(token); }
                        }
                        // Plain text: not live, since the status line announces a
                        // connect once, and not a Tab stop, since nothing acts on it.
                        Text {
                            horizontal-stretch: 1;
                            text: root.printer-line;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: AccessibleRole.text;
                            accessible-label: "Printer";
                            accessible-value: root.printer-line;
                        }
                    }

                    // Above the view, so the bars take their height from the canvas
                    // column and none from the pane. One row, the edit bar first: the
                    // zoom readout is the part that elides when the column is narrow.
                    HorizontalLayout {
                        spacing: 12px;
                        edit-bar := EditBar {
                            add(kind) => { root.add-kind(kind); }
                            delete-selected => { root.remove-selected(); }
                        }
                        bar := ZoomBar {
                            fit => { root.zoom-fit(); }
                            one => { root.zoom-one(); }
                            step(by) => { root.zoom-step(by); }
                        }
                    }

                    // The canvas keeps a Rectangle of its own: it sets its width from
                    // the label and is routinely wider than the window.
                    column := Rectangle {
                        vertical-stretch: 1;
                        property <length> bar-size: 12px;
                        // Positioned, so none of this is counted in the column's own
                        // size: a 1280-pixel canvas still cannot push the pane out of
                        // the window (12c's reason, kept). The bars' room is reserved
                        // whether or not they are drawn, so a bar appearing never
                        // resizes the port.
                        //
                        // An ancestor of every element's TouchArea. An element rejects
                        // a wheel by default, so the wheel passes out to here
                        // (input_items.rs:193-212, input.rs:1681-1695); while pressed
                        // the element answers GrabMouse and keeps it
                        // (input_items.rs:198-199), so nothing pans under a drag. No
                        // Flickable: it would delay every press, or intercept
                        // Ctrl+wheel for 800 ms after its own scroll (flickable.rs:376,
                        // :726-758).
                        wheel := TouchArea {
                            x: 0px;
                            y: 0px;
                            width: Math.max(0px, parent.width - parent.bar-size);
                            height: Math.max(0px, parent.height - parent.bar-size);
                            scroll-event(e) => {
                                if (e.modifiers.control) {
                                    root.zoom-wheel(e.delta-y / 1px, self.mouse-x / 1phx, self.mouse-y / 1phx);
                                } else if (e.modifiers.shift && e.delta-x == 0px) {
                                    // A vertical wheel with Shift held pans across where
                                    // the platform has not already turned it; macOS has,
                                    // and its travel then arrives horizontal and takes
                                    // the plain path below.
                                    root.pan-by(-e.delta-y / 1phx, 0);
                                } else {
                                    // Travel with nothing across, over a view with no
                                    // room down, pans across in Rust
                                    // (view::wheel_travel), beside the pan's range.
                                    root.pan-by(-e.delta-x / 1phx, -e.delta-y / 1phx);
                                }
                                return EventResult.accept;
                            }

                            port := Rectangle {
                                width: 100%;
                                height: 100%;
                                background: #f4f4f4;
                                // Clipped here rather than by the window, so an oversized
                                // plane does not paint under the fields beside it.
                                clip: true;

                                canvas := LabelCanvas {
                                    // Top-left on both axes, at the pan. Anchored rather
                                    // than centred: a centred canvas wider or taller
                                    // than its view loses the label's start off both
                                    // edges, and moves whenever the column's size does.
                                    // A pan of 0 always means the label's origin, which
                                    // Fit, the reveal and the anchors all use.
                                    x: -root.pan-x * 1phx;
                                    y: -root.pan-y * 1phx;
                                    viewed: true;
                                    seen-x: root.pan-x * 1phx;
                                    seen-y: root.pan-y * 1phx;
                                    seen-width: port.width;
                                    seen-height: port.height;
                                    // Every way the keyboard can leave the pane for the
                                    // canvas ends in one of these two, and the next field
                                    // it enters is an arrival rather than a return
                                    // (inspector.slint). Selecting commits what was typed
                                    // on the Rust side.
                                    select(id) => {
                                        inspector.keyboard-at = -1;
                                        root.select(id);
                                    }
                                    // Bare canvas selects nothing, so nothing else would
                                    // finish what was typed.
                                    surface-focused() => {
                                        inspector.keyboard-at = -1;
                                        root.field-commit();
                                    }
                                    begin-move(id) => { root.begin-move(id); }
                                    move-to(id, x, y) => { root.move-to(id, x, y); }
                                    end-move(c) => { root.end-move(c); }
                                    nudge(id, dx, dy, c) => { root.nudge(id, dx, dy, c); }
                                    set-say(id, v) => { root.set-say(id, v); }
                                    begin-resize(id, g) => { root.begin-resize(id, g); }
                                    resize-to(id, r, b) => { root.resize-to(id, r, b); }
                                    undo() => { root.history(false); }
                                    redo() => { root.history(true); }
                                }
                            }
                        }

                        Scroller {
                            x: 0px;
                            y: wheel.height;
                            width: wheel.width;
                            height: parent.bar-size;
                            horizontal: true;
                            lo: root.scene-x;
                            whole: root.scene-w;
                            shown: root.view-px-w;
                            offset: root.pan-x;
                            to(at) => { root.pan-to(at, root.pan-y); }
                        }
                        Scroller {
                            x: wheel.width;
                            y: 0px;
                            width: parent.bar-size;
                            height: wheel.height;
                            horizontal: false;
                            lo: root.scene-y;
                            whole: root.scene-h;
                            shown: root.view-px-h;
                            offset: root.pan-y;
                            to(at) => { root.pan-to(root.pan-x, at); }
                        }
                    }
                }

                inspector := Inspector {
                    field-edited(f, v) => { root.field-edited(f, v); }
                    field-commit() => { root.field-commit(); }
                    field-stepped(f, b) => { root.field-stepped(f, b); }
                }
            }
        }

        status-row := Rectangle {
            vertical-stretch: 0;
            // Exactly two lines, whatever it holds. A note written inside a press - the
            // refusal a staged field's commit makes when the press selects - must not
            // change the panes' height under the pointer, for the reason the pane's
            // width must not. One line's height is measured rather than chosen.
            height: 2 * line.preferred-height;
            line := Text {
                x: 0px;
                y: 0px;
                text: " ";
                visible: false;
                accessible-role: AccessibleRole.none;
            }
            Text {
                width: parent.width;
                height: parent.height;
                text: root.status;
                wrap: word-wrap;
                // Elided past two lines on screen (textlayout/sharedparley.rs:945); the
                // whole sentence is still the value the live region announces.
                overflow: elide;
                accessible-role: AccessibleRole.text;
                accessible-label: "Status";
                accessible-value: root.status;
                // The only channel a refusal has, and the reason it needs no modal: a
                // live region is announced when it changes. Polite, because a refused
                // field edit blocks nothing and the field itself already holds the
                // truth.
                accessible-live-region: AccessibleLiveness.polite;
            }
        }
    }

    // Children of the Designer rather than of any layout, so neither takes room
    // from the panes. Centred, with their tops at the view's: below the padding and
    // the two bars' rows, so no button the operator reads is covered.
    unsaved := UnsavedQuestion {
        x: (root.width - self.width) / 2;
        y: 84px;
        question: root.unsaved-question;
        reply(answer) => { root.unsaved-reply(answer); }
    }
    new-pane := NewLabelPane {
        x: (root.width - self.width) / 2;
        y: 84px;
        printer: root.new-printer;
        across: root.new-across;
        about: root.new-about;
        feed-start: root.new-feed-start;
        hint: root.new-hint;
        note: root.new-note;
        presets: root.new-presets;
        feed-edited(text) => { root.new-feed-edited(text); }
        check(text) => { return root.new-check(text); }
        make(text) => { root.new-make(text); }
        preset(token) => { root.new-preset(token); }
        cancel => { root.new-cancel(); }
    }
    // As wide as the window allows, up to 700 px: print.rs fits the image to the
    // same arithmetic.
    preview-pane := PreviewPane {
        x: (root.width - self.width) / 2;
        y: 84px;
        width: Math.min(700px, root.width - 40px);
        // Down to the status line, less the layout's spacing above it, so the pane
        // never covers the line that says what the link is doing. The status line is
        // two lines tall whatever it holds, so this does not move while it talks.
        room: status-row.y - self.y - 8px;
        verdict: root.preview-verdict;
        step: root.preview-step;
        plane: root.preview-plane;
        plane-px-w: root.preview-plane-px-w;
        plane-px-h: root.preview-plane-px-h;
        plane-says: root.preview-plane-says;
        facts: root.preview-facts;
        issues: root.preview-issues;
        choices: root.preview-choices;
        primary: root.preview-primary;
        primary-says: root.preview-primary-says;
        primary-shown: root.preview-primary-shown;
        primary-default: root.preview-primary-default;
        close-says: root.preview-close-says;
        focus-to: root.preview-focus-to;
        focus-serial: root.preview-focus-serial;
        act(what) => { root.preview-act(what); }
        choose(index) => { root.preview-choose(index); }
    }
}
