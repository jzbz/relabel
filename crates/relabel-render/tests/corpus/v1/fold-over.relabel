{
  "format": "relabel-label",
  "version": 1,
  "meta": { "title": "corpus: fold-over stock with a tail" },
  "media": {
    "feed_tenths_mm": 400,
    "head_tenths_mm": 120,
    "shape": { "kind": "rounded_rect", "radius": 8 },
    "tail": { "at_start": true, "len_dots": 40 },
    "fold": { "at_dots": 180, "parts": 2 }
  },
  "canvas": { "feed": 320, "head": 96, "dpmm": { "num": 8, "den": 1 } },
  "elements": [
    { "type": "rect", "id": 1, "frame": { "feed": 48, "head": 16, "feed_len": 60, "head_len": 8 } },
    { "type": "text", "id": 2, "frame": { "feed": 48, "head": 32, "feed_len": 120, "head_len": 24 }, "text": "PORT 4", "size": 20.0 }
  ],
  "repeat": "flip"
}
