{
  "format": "relabel-label",
  "version": 1,
  "meta": {
    "title": "corpus: variable data",
    "app": "relabel 0.1.0",
    "authored_for": { "model": "D110_M", "head_px": 96, "dpi": 203 }
  },
  "media": { "feed_tenths_mm": 400, "head_tenths_mm": 120 },
  "canvas": { "feed": 320, "head": 96, "dpmm": { "num": 8, "den": 1 } },
  "data": { "kind": "csv_file", "path": "variables.csv", "delimiter": ",", "has_header": true },
  "elements": [
    { "type": "text", "id": 1, "name": "Product", "frame": { "feed": 8, "head": 4, "feed_len": 304, "head_len": 26 }, "text": "{name}", "family": "Noto Sans", "size": 20.0 },
    { "type": "barcode", "id": 2, "name": "SKU barcode", "frame": { "feed": 8, "head": 32, "feed_len": 304, "head_len": 44 }, "symbology": "code128", "data": "{sku}", "module_dots": 2, "bar_dots": 44 },
    { "type": "text", "id": 3, "name": "Packed", "frame": { "feed": 8, "head": 78, "feed_len": 304, "head_len": 16 }, "text": "Packed {dt|YYYY-MM-DD}", "family": "Noto Sans", "size": 12.0 }
  ]
}
